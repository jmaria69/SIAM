APP_HOST=0.0.0.0
APP_PORT=8001

# development (default) deja /docs, /redoc y /openapi.json activos.
# production los desactiva por completo (siem/main.py::create_app) -- ponlo
# en production explícitamente en el .env del servidor real desplegado.
ENVIRONMENT=development

CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# Motor de IA plegable: anthropic | openai | local | none
# Con AI_PROVIDER=none (o si falta la API key correspondiente) el sistema
# sigue funcionando con explicaciones basadas en reglas — no bloquea la demo.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cualquier endpoint compatible con la API de OpenAI, p.ej. Ollama local:
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# Notificaciones Telegram (usado por simulate_crisis.py)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Correlación de eventos (módulo 4)
CORRELATION_WINDOW_MINUTES=15

# SMTP para campañas de concienciación Y para la alerta de incidentes nuevos
# (mismo servidor, dos usos). Sin SMTP_HOST/SMTP_USER/SMTP_PASSWORD no se
# envía nada, se omite en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Alerta por email al crearse un incidente NUEVO (ataque detectado). Sin
# ALERT_EMAIL_TO no se envía nada. ALERT_EMAIL_MIN_SEVERITY filtra ruido:
# info | baja | media | alta | critica.
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_SEVERITY=media
